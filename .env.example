# Velo backend environment. Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB Atlas or local MongoDB. Not needed for `npm run dev:memory`.
MONGODB_URI=

# --- Ground station ---
# The ground station sends this in the `x-device-key` header.
# Required when NODE_ENV=production (the device API refuses requests without it).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=

# --- Admin login ---
# The only account that can sign in to the admin dashboard.
ADMIN_EMAIL=
# Recommended: a scrypt hash made with `npm run hash-password -- "your password"`.
ADMIN_PASSWORD_HASH=
# Simpler alternative to the hash (plain text, server side only). Leave empty if you use the hash.
ADMIN_PASSWORD=
# Signs admin session tokens. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# How long an admin stays signed in, in hours.
ADMIN_SESSION_HOURS=12
# Optional: lets scripts call the admin API with an `x-admin-key` header instead of signing in.
ADMIN_API_KEY=

# --- Browser access ---
# Comma-separated origins allowed to call the API, e.g. https://velo-frontend.vercel.app,https://velo-flame.vercel.app
# `*` allows every origin; use real origins in production.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# --- Camera / fleet rules ---
# An "available" bike not seen by the camera for this long is flagged as missing.
MISSING_BIKE_TIMEOUT_MINUTES=10
# A ground station with no heartbeat for this long is shown as offline.
DEVICE_OFFLINE_AFTER_SECONDS=90
