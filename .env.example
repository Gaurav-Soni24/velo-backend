# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/bike-rental-iot

# --- Security ---
# The ground station must send this in the `x-device-key` header. Leave empty only for local development.
DEVICE_API_KEY=change-me-device-key
# Optional: protect the admin API with `x-admin-key`.
ADMIN_API_KEY=
# Comma-separated list of allowed browser origins (admin dashboard, landing app). `*` allows all.
CORS_ORIGIN=*

# --- Camera / fleet rules ---
# An "available" bike not seen by the camera for this long is flagged as missing.
MISSING_BIKE_TIMEOUT_MINUTES=10
# A ground station with no heartbeat for this long is shown as offline.
DEVICE_OFFLINE_AFTER_SECONDS=90
