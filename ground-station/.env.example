# Where the cloud API lives
API_URL=http://localhost:5000
# Must match DEVICE_API_KEY on the server
DEVICE_KEY=change-me-device-key

# Identity shown in the admin panel
DEVICE_ID=stand-01
DEVICE_NAME=Main Gate Stand
DEVICE_LOCATION=Campus main gate

# serial = real Arduino, simulator = type commands in the terminal
MODE=simulator
SERIAL_PORT=COM3
BAUD_RATE=9600

HEARTBEAT_SECONDS=30
DEBOUNCE_MS=3000
